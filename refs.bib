}

@article{muthen1984general,
  title = {A General Structural Equation Model with Dichotomous, Ordered Categorical, and Continuous Latent Variable Indicators},
  author = {Muthén, Bengt},
  date = {1984-03-01},
  journaltitle = {Psychometrika},
